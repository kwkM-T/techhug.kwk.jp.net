---
import affiliatesData from '../data/affiliates.json';

interface AffiliateItem {
  id: string;
  aliases?: string[];
  title: string;
  description: string;
  imageUrl?: string | null;
  amazonUrl?: string | null;
  rakutenUrl?: string | null;
  otherUrl?: string | null;
  otherLabel?: string | null;
}

interface Props {
  id: string | number;
}

const { id } = Astro.props;
const targetId = String(id);

// affiliates.json から id または aliases に一致する商品データを検索
const item = (affiliatesData as AffiliateItem[]).find(
  (a) => a.id === targetId || (a.aliases && a.aliases.includes(targetId))
);

// IDが存在しない場合はコンソール警告を出力
if (!item) {
  console.warn(`⚠️ [AffiliateCard] 警告: 指定された商品ID "${id}" は affiliates.json に存在しません。`);
}

// メインの遷移先URL（AmazonがあればAmazon、無ければ楽天またはその他）
const primaryUrl = item?.amazonUrl || item?.rakutenUrl || item?.otherUrl || '#';
---

{item && (
  <div class="my-8 bg-white border border-slate-200 rounded-xl p-4 sm:p-6 shadow-sm hover:shadow-md transition-shadow duration-200 relative overflow-hidden not-prose">
    <div class="absolute top-2 right-2 bg-slate-100 text-slate-500 text-[10px] font-bold px-2 py-0.5 rounded border border-slate-200">
      PR
    </div>

    <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6">
      {item.imageUrl && (
        <div class="w-full sm:w-44 h-44 sm:h-44 shrink-0 flex items-center justify-center bg-slate-50 rounded-lg p-2 border border-slate-100 overflow-hidden">
          <a
            href={primaryUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
            class="w-full h-full flex items-center justify-center group"
            title={item.title}
          >
            <img
              src={item.imageUrl}
              alt={item.title}
              class="max-w-full max-h-full object-contain group-hover:scale-105 transition-transform duration-200"
              loading="lazy"
            />
          </a>
        </div>
      )}

      <div class="flex-grow flex flex-col justify-between w-full">
        <div>
          <h4 class="text-base sm:text-lg font-bold text-slate-900 leading-snug pr-8">
            <a
              href={primaryUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="hover:text-emerald-600 transition-colors"
            >
              {item.title}
            </a>
          </h4>

          {item.description && (
            <p class="mt-2 text-xs sm:text-sm text-slate-600 leading-relaxed">
              {item.description}
            </p>
          )}
        </div>

        <div class="mt-4 flex flex-col sm:flex-row sm:flex-wrap gap-2.5">
          {item.amazonUrl && (
            <a
              href={item.amazonUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-2 bg-[#ff9900] hover:bg-[#e68a00] text-white text-xs font-bold rounded-md shadow-xs hover:shadow transition-all duration-150 w-full sm:w-auto min-w-[120px] text-center"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <path d="M13.92 3.82c-.93 0-1.8.2-2.59.56l.33 1.15c.67-.32 1.4-.49 2.19-.49 2.05 0 3.32 1.05 3.32 2.8v.3c-.63-.33-1.42-.51-2.31-.51-2.4 0-4.04 1.34-4.04 3.32 0 1.95 1.49 3.19 3.55 3.19 1.4 0 2.44-.6 3.01-1.61v1.39h1.36V7.78c0-2.47-1.87-3.96-4.83-3.96zm.52 9.53c-1.4 0-2.37-.8-2.37-2.07 0-1.28.98-2.07 2.45-2.07.72 0 1.35.19 1.83.54v1.54c-.45 1.25-1.19 2.06-1.91 2.06zm-7.9 4.39c4.27 2.37 9.87 2.01 13.98-.94.2-.14.41.05.27.23-3.92 3.42-9.76 3.73-14.46 1.06-.32-.18-.08-.54.21-.35z"/>
              </svg>
              <span>Amazonで見る</span>
            </a>
          )}

          {item.rakutenUrl && (
            <a
              href={item.rakutenUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-2 bg-[#bf0000] hover:bg-[#990000] text-white text-xs font-bold rounded-md shadow-xs hover:shadow transition-all duration-150 w-full sm:w-auto min-w-[120px] text-center"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <path fill="#ffffff" d="M8 8h4.5a2.5 2.5 0 0 1 0 5H10v3H8V8zm2 3.5h2.5a1 1 0 0 0 0-2H10v2z"/>
              </svg>
              <span>楽天市場で見る</span>
            </a>
          )}

          {item.otherUrl && (
            <a
              href={item.otherUrl}
              target="_blank"
              rel="nofollow sponsored noopener"
              class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 sm:py-2 bg-slate-700 hover:bg-slate-800 text-white text-xs font-bold rounded-md shadow-xs hover:shadow transition-all duration-150 w-full sm:w-auto min-w-[120px] text-center"
            >
              <span>{item.otherLabel || '公式ストアを見る'}</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
)}

{!item && (
  <div class="my-6 p-4 border-2 border-dashed border-amber-300 bg-amber-50 rounded-lg text-amber-800 text-xs not-prose">
    <div class="flex items-center gap-2 font-bold mb-1">
      <span class="text-base">⚠️</span>
      <span>アフィリエイト商品が見つかりません</span>
    </div>
    <p>
      指定された商品ID <code>"{id}"</code> は <code>src/data/affiliates.json</code> に登録されていません。IDをご確認ください。
    </p>
  </div>
)}