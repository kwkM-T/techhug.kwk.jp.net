---
interface Props {
  id?: string;
  className?: string;
  isModal?: boolean;
}

const { id = "search-widget", className = "", isModal = false } = Astro.props;
---

<div class={`pagefind-search-container ${className}`}>
  <div id={id} class="pagefind-ui-wrapper"></div>
</div>

<script is:inline define:vars={{ containerId: id }}>
  function initPagefind() {
    const el = document.getElementById(containerId);
    if (!el) return;

    // 既に初期化済みの場合はスキップ
    if (el.getAttribute('data-pagefind-initialized')) return;

    if (typeof PagefindUI !== 'undefined') {
      try {
        new PagefindUI({
          element: `#${containerId}`,
          showImages: true,
          showSubResults: true,
          resetStyles: false,
          translations: {
            placeholder: "キーワードで記事を検索...",
            clear_search: "クリア",
            load_more: "さらに読み込む",
            search_label: "サイト内を検索",
            filters_label: "フィルター",
            zero_results: "「[SEARCH_TERM]」に一致する記事は見つかりませんでした。",
            many_results: "「[SEARCH_TERM]」の検索結果: [COUNT]件",
            one_result: "「[SEARCH_TERM]」の検索結果: 1件",
            alt_search: "一致する記事がありません。[SEARCH_TERM]の検索結果を表示しています。",
            search_suggestion: "もしかして: [SEARCH_TERM]",
            searching: "検索中..."
          }
        });
        el.setAttribute('data-pagefind-initialized', 'true');
      } catch (e) {
        console.warn('Pagefind init failed:', e);
      }
    } else {
      // pagefind-ui.js が未読み込みの場合（開発時など）のフォールバック
      el.innerHTML = `
        <div class="p-3 bg-slate-50 border border-slate-200 rounded text-xs text-slate-500 text-center">
          🔍 検索機能は <code>npm run build</code> でインデックス生成後にご利用いただけます
        </div>
      `;
    }
  }

  // DOMロード時およびAstro ViewTransitions等のページ遷移に対応
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagefind);
  } else {
    initPagefind();
  }
  document.addEventListener('astro:page-load', initPagefind);
</script>

<style is:global>
  /* Pagefind UI のカスタムテーマ定義（ブログの白＆ブルー基調に統一） */
  :root {
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: #2563eb;
    --pagefind-ui-text: #1e293b;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #cbd5e1;
    --pagefind-ui-tag: #f1f5f9;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 16 / 9;
    --pagefind-ui-font: inherit;
  }

  .pagefind-ui .pagefind-ui__search-input {
    font-size: 0.875rem !important;
    padding: 0.5rem 0.75rem 0.5rem 2.25rem !important;
    border-radius: 6px !important;
    border: 1px solid #cbd5e1 !important;
    background-color: #ffffff !important;
    color: #1e293b !important;
    transition: all 0.2s ease;
  }

  .pagefind-ui .pagefind-ui__search-input:focus {
    outline: none !important;
    border-color: #2563eb !important;
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.15) !important;
  }

  .pagefind-ui .pagefind-ui__search-clear {
    font-size: 0.75rem !important;
    padding: 0 0.5rem !important;
    background-color: #f1f5f9 !important;
    color: #64748b !important;
    border-radius: 4px !important;
  }

  .pagefind-ui .pagefind-ui__drawer {
    margin-top: 0.75rem !important;
  }

  .pagefind-ui .pagefind-ui__result {
    padding: 0.875rem 0 !important;
    border-top: 1px solid #f1f5f9 !important;
  }

  .pagefind-ui .pagefind-ui__result-title {
    font-size: 0.95rem !important;
    font-weight: 700 !important;
  }

  .pagefind-ui .pagefind-ui__result-link {
    color: #1e293b !important;
    text-decoration: none !important;
  }

  .pagefind-ui .pagefind-ui__result-link:hover {
    color: #2563eb !important;
    text-decoration: underline !important;
  }

  .pagefind-ui .pagefind-ui__result-excerpt {
    font-size: 0.8rem !important;
    color: #64748b !important;
    margin-top: 0.25rem !important;
    line-height: 1.6 !important;
  }

  .pagefind-ui mark {
    background-color: #fef08a !important;
    color: #854d0e !important;
    padding: 0.1em 0.25em !important;
    border-radius: 2px !important;
    font-weight: 600 !important;
  }
</style>
