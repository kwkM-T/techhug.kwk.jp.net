---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import AffiliateCard from '../../components/AffiliateCard.astro';
import AdSenseUnit from '../../components/AdSenseUnit.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  
  // 日付順（古い順）にソートして前後の記事を計算
  const sortedPosts = [...posts].sort(
    (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
  );

  return sortedPosts.map((post, index) => {
    const prevPost = index > 0 ? sortedPosts[index - 1] : null;
    const nextPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;

    return {
      params: { slug: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

// 目次に含める見出し（h2, h3）を抽出
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ja-JP', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).format(date);
}
---

<BaseLayout 
  title={post.data.title} 
  description={post.data.description} 
  image={post.data.heroImage}
>
  <article class="bg-white rounded-lg border border-slate-200 p-4 sm:p-8 lg:p-10 shadow-2xs" data-pagefind-body>
    <!-- 記事ヘッダー -->
    <header class="mb-6 sm:mb-8 pb-5 sm:pb-6 border-b border-slate-200">
      <!-- カテゴリ・タグ -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-3">
          {post.data.tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="inline-block bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold px-2.5 py-0.5 rounded transition"
              data-pagefind-filter="tag"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <!-- 記事タイトル -->
      <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug" data-pagefind-meta="title">
        {post.data.title}
      </h1>

      <!-- 日付情報 -->
      <div class="mt-4 flex flex-wrap items-center gap-4 text-xs text-slate-500">
        <span class="flex items-center gap-1.5 font-medium">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          公開日: <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </span>
        {post.data.updatedDate && (
          <span class="flex items-center gap-1.5 font-medium text-slate-600">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
            </svg>
            更新日: <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time>
          </span>
        )}
      </div>
    </header>

    <!-- アイキャッチ画像 -->
    {post.data.heroImage && (
      <div class="mb-8 rounded-lg overflow-hidden border border-slate-200">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="w-full h-auto max-h-[420px] object-cover"
          data-pagefind-meta="image[src]"
        />
      </div>
    )}

    <!-- 記事タイトル下（本文前）の広告枠（AdSense） -->
    <AdSenseUnit slot="1111111111" />

    <!-- 自動生成の目次 (Cocoon風) -->
    {toc.length > 0 && (
      <nav class="mb-8 sm:mb-10 bg-slate-50 border border-slate-200 rounded-lg p-4 sm:p-5" data-pagefind-ignore>
        <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200">
          <span class="text-sm font-bold text-slate-800 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-blue-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            目次
          </span>
        </div>
        <ul class="space-y-1.5 text-sm text-slate-700">
          {toc.map((heading) => (
            <li class={heading.depth === 3 ? "pl-5 text-xs text-slate-600" : "font-medium"}>
              <a
                href={`#${heading.slug}`}
                class="hover:text-blue-600 hover:underline transition-colors flex items-center gap-1.5"
              >
                <span class="text-slate-400 text-xs">›</span>
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- 記事本文 -->
    <div class="prose prose-slate max-w-none prose-headings:scroll-mt-20">
      <Content components={{ AffiliateCard }} />
    </div>

    <!-- 記事本文の最後（関連記事前）の広告枠（AdSense） -->
    <AdSenseUnit slot="2222222222" />

    <!-- 前後の記事ナビゲーション (Cocoon風) -->
    <nav class="mt-12 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4" data-pagefind-ignore>
      {prevPost ? (
        <a
          href={`/blog/${prevPost.id}/`}
          class="flex flex-col p-4 rounded-lg border border-slate-200 hover:border-blue-400 hover:bg-blue-50/40 transition group"
        >
          <span class="text-xs text-slate-400 font-semibold mb-1 flex items-center gap-1 group-hover:text-blue-600">
            &larr; 前の記事
          </span>
          <span class="text-sm font-bold text-slate-800 group-hover:text-blue-600 line-clamp-2">
            {prevPost.data.title}
          </span>
        </a>
      ) : (
        <div></div>
      )}

      {nextPost && (
        <a
          href={`/blog/${nextPost.id}/`}
          class="flex flex-col p-4 rounded-lg border border-slate-200 hover:border-blue-400 hover:bg-blue-50/40 transition group text-right sm:text-right"
        >
          <span class="text-xs text-slate-400 font-semibold mb-1 flex items-center justify-end gap-1 group-hover:text-blue-600">
            次の記事 &rarr;
          </span>
          <span class="text-sm font-bold text-slate-800 group-hover:text-blue-600 line-clamp-2">
            {nextPost.data.title}
          </span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
