---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="お問い合わせ" 
  description="当ブログへのお問い合わせフォームです。ご意見・ご感想、ご質問、お仕事のご依頼などはこちらからお願いいたします。"
>
  <article class="bg-white rounded-lg border border-slate-200 p-4 sm:p-8 lg:p-10 shadow-2xs" data-pagefind-body>
    <header class="mb-6 sm:mb-8 pb-4 border-b border-slate-200">
      <h1 class="text-xl sm:text-3xl font-extrabold text-slate-900 tracking-tight" data-pagefind-meta="title">
        お問い合わせ
      </h1>
      <p class="mt-2 text-xs text-slate-500">
        記事に関するご質問やご意見、お仕事のご依頼等はお気軽に以下のフォームよりご連絡ください。
      </p>
    </header>

    <div class="max-w-2xl">
      <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-md text-xs text-emerald-800 leading-relaxed">
        <p class="font-bold mb-1">【お問い合わせいただく際のお願い】</p>
        <ul class="list-disc pl-4 space-y-0.5">
          <li>通常、2〜3営業日以内に返信いたします。</li>
          <li>内容によってはお答えできない場合もございますので予めご了承ください。</li>
        </ul>
      </div>

      <!-- お問い合わせフォームひな形 -->
      <form class="space-y-5" onsubmit="event.preventDefault(); alert('お問い合わせフォームのひな形です。FormspreeやGoogleフォーム、SSG向けフォームサービスと連携してご利用ください。');">
        <div>
          <label for="name" class="block text-xs font-bold text-slate-700 mb-1">
            お名前（またはニックネーム） <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            placeholder="山田 太郎"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
          />
        </div>

        <div>
          <label for="email" class="block text-xs font-bold text-slate-700 mb-1">
            メールアドレス <span class="text-red-500">*</span>
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="example@example.com"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
          />
        </div>

        <div>
          <label for="subject" class="block text-xs font-bold text-slate-700 mb-1">
            件名
          </label>
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="記事についてのご質問、など"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
          />
        </div>

        <div>
          <label for="message" class="block text-xs font-bold text-slate-700 mb-1">
            お問い合わせ内容 <span class="text-red-500">*</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            placeholder="お問い合わせ内容を具体的にご記入ください。"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-md focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold rounded-md shadow-xs hover:shadow transition"
        >
          送信する（ひな形テスト）
        </button>
      </form>
    </div>
  </article>
</BaseLayout>
